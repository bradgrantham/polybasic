REM GRIFFIN BASIC
10 REM TWO PAGES: DRAW ON THE HIDDEN ONE, THEN SHOW IT
20 CLS 0
30 GPRINT 100, 100, "PAGE ZERO"
40 FOR frame = 1 TO 4
50 PAGE 1, 0
60 CLS RGB(0, 64, 0)
70 FCIRCLE 40 + frame * 50, 120, 20, RGB(255, 255, 0)
80 GPRINT 90, 20, "PAGE ONE, FRAME" + STR$(frame)
90 PAGE 1, 1
100 VSYNC
110 PAGE 0, 0
120 VSYNC
130 NEXT frame
140 PAGE 1, 1
150 PRINT "SHOWING PAGE ONE"
