REM GRIFFIN BASIC
10 REM EVERY DRAWING STATEMENT ONCE
20 CLS RGB(0, 0, 96)
30 COLOR RGB(255, 255, 255)
40 RECT 0, 0, SCRW, SCRH
50 GPRINT 8, 6, "GRIFFIN BASIC gfx: Shapes"
60 REM A FAN OF LINES
70 FOR i = 0 TO 15
80 LINE 20, 120, 100, 30 + i * 6, RGB(255, 255 - i * 16, i * 16)
90 NEXT i
100 REM RECTANGLES, SOME OFF THE EDGE
110 FRECT 120, 30, 60, 40, RGB(255, 0, 0)
120 RECT 125, 35, 50, 30, RGB(255, 255, 0)
130 FRECT 300, 100, 60, 30, RGB(0, 255, 0)
140 REM CIRCLES
150 FCIRCLE 230, 60, 28, RGB(0, 160, 255)
160 CIRCLE 230, 60, 34
170 CIRCLE 310, 230, 40, RGB(255, 0, 255)
180 REM THE 256 COLOURS
190 FOR c = 0 TO 255
200 FRECT 16 + (c - INT(c / 32) * 32) * 9, 140 + INT(c / 32) * 9, 8, 8, c
210 NEXT c
220 REM POINTS, AND READING THEM BACK
230 FOR x = 0 TO 60 STEP 2: PSET 120 + x, 80 + x / 4: NEXT x
240 PRINT POINT(120, 80); POINT(121, 80); POINT(-1, 0); POINT(150, 50)
250 REM A SPRITE: DRAW IT, TAKE IT, STAMP IT
260 FRECT 200, 100, 16, 16, 0
270 FCIRCLE 207, 107, 7, RGB(255, 200, 0)
280 PSET 205, 105, 0: PSET 210, 105, 0: LINE 204, 110, 211, 110, 0
290 SPRITE DEFINE 1, 200, 100, 16, 16
300 FOR i = 0 TO 5
310 SPRITE 1, 110 + i * 20, 112 + i * 3
320 NEXT i
330 SPRITE DRAW 1, -8, 200
340 SPRITE DEFINE 2, 200, 100, 16, 16, -1
350 SPRITE 2, 240, 116
360 PRINT "DONE"
