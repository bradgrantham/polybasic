REM GRIFFIN BASIC
10 REM LONG NAMES, KEYWORDS THAT STAND ALONE, ELSE, THE CLOCK
20 total = 0: counter = 5
30 FOR index = 1 TO counter: total = total + index: NEXT index
40 PRINT "TOTAL"; total
50 REM NAMES MAY CONTAIN KEYWORDS
60 forty = 40: toronto = 2: scorend = forty + toronto
70 PRINT scorend
80 name$ = "GRIFFIN": PRINT LEFT$(name$, 4); LEN(name$)
90 IF total > 10 THEN PRINT "BIG" ELSE PRINT "SMALL"
100 IF total > 100 THEN PRINT "HUGE" ELSE PRINT "NOT HUGE"
110 DIM scores(3): scores(2) = 7: PRINT scores(2); Scores(2)
120 DEF FN double(x) = x * 2: PRINT FN double(21)
130 t1 = TIMER: IF t1 >= 0 AND t1 < 90000 THEN PRINT "TIMER OK"
140 d$ = DATE$: IF LEN(d$) = 10 AND MID$(d$, 5, 1) = "-" THEN PRINT "DATE OK"
150 c$ = TIME$: IF LEN(c$) = 8 AND MID$(c$, 3, 1) = ":" THEN PRINT "TIME OK"
160 PRINT RGB(255, 0, 0); RGB(0, 255, 0); RGB(0, 0, 255); RGB(255, 255, 255)
170 PRINT SCRW; SCRH
180 k$ = INKEY$: PRINT "["; k$; "]"; LEN(INKEY$)
190 PRINT JOY(0); JOY(1); JOY(2); PADDLE(0)
200 PRINT PLAYING(0)
210 GOTO 230
220 PRINT "NOT REACHED"
230 ON 2 GOSUB 300, 310
240 PRINT "KEYWORDS NEED A SPACE: THE NEXT LINE IS AN ERROR"
250 GOTO300
260 END
300 PRINT "FIRST": RETURN
310 PRINT "SECOND": RETURN
