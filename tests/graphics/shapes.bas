REM APPLESOFT BASIC
10 REM SHAPE TABLE: THE SQUARE FROM THE APPLESOFT MANUAL, POKED INTO PAGE 3
20 FOR I = 0 TO 13: READ B: POKE 768 + I,B: NEXT
30 DATA 1,0,4,0,18,63,32,100,45,21,54,30,7,0
40 POKE 232,0: POKE 233,3
50 HGR2 : HCOLOR= 3
60 FOR S = 1 TO 6: SCALE= S: ROT= 0: DRAW 1 AT 10 + S * 20,30: NEXT
70 SCALE= 8: FOR R = 0 TO 48 STEP 16: ROT= R: DRAW 1 AT 40 + R * 4,90: NEXT
80 FOR R = 0 TO 15: ROT= R: DRAW 1 AT 140,150: NEXT
90 REM XDRAW TWICE LEAVES NOTHING; ONCE OVER A DRAWN SHAPE ERASES IT
100 ROT= 0: SCALE= 10: XDRAW 1 AT 230,40: XDRAW 1 AT 230,40
110 DRAW 1 AT 230,150: XDRAW 1 AT 235,150
120 HCOLOR= 5: SCALE= 3: DRAW 1 AT 20,170: HCOLOR= 6: DRAW 1
130 PRINT PEEK (230); " "; PEEK (232) + 256 * PEEK (233)
140 ONERR GOTO 160
150 DRAW 2
160 PRINT "NO SHAPE 2"
