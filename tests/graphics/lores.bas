REM APPLESOFT BASIC
10 REM LO-RES: ALL SIXTEEN COLOURS, LINES, SCRN, AND TEXT BELOW
20 GR
30 FOR C = 0 TO 15: COLOR= C: VLIN 4,35 AT C * 2 + 4: VLIN 4,35 AT C * 2 + 5: NEXT
40 COLOR= 15: HLIN 0,39 AT 0: HLIN 39,0 AT 39: VLIN 0,39 AT 0: VLIN 39,0 AT 39
50 COLOR= 9: PLOT 2,2: PLOT 37,37: COLOR= 17: PLOT 37,2
60 PRINT "SCRN "; SCRN( 6,10);" "; SCRN( 37,2);" "; SCRN( 1,1)
70 PRINT "LO-RES COLOR BARS"
80 ONERR GOTO 100
90 PLOT 40,0
100 PRINT "ERROR "; PEEK (216) > 127: POKE 216,0
110 PLOT 0,48
