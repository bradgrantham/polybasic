REM APPLESOFT BASIC
10 D$ = CHR$ (4)
20 PRINT D$;"OPEN SCORES"
30 PRINT D$;"WRITE SCORES"
40 FOR I = 1 TO 3: PRINT "PLAYER";I: PRINT I * 100: NEXT
50 PRINT D$;"CLOSE SCORES"
60 PRINT D$;"APPEND SCORES": PRINT D$;"WRITE SCORES"
70 PRINT "LAST ONE": PRINT 999
80 PRINT D$;"CLOSE"
90 ONERR GOTO 200
100 PRINT D$;"OPEN SCORES": PRINT D$;"READ SCORES"
110 INPUT N$,S: PRINT D$: PRINT N$;" ";S: PRINT D$;"READ SCORES": GOTO 110
200 PRINT D$;"CLOSE": PRINT "END OF FILE AFTER ";N$
210 REM A FILE THAT IS ALREADY ON THE DISK, AND ONE THAT IS NOT
220 PRINT "<CTRL-D>OPEN FIXTURE": PRINT "<CTRL-D>READ FIXTURE"
230 INPUT A$: INPUT B: GET C$: GET E$
240 PRINT D$;"CLOSE FIXTURE"
250 PRINT A$;B;C$;E$
260 REM RANDOM ACCESS
270 PRINT D$;"OPEN RA,L10"
280 FOR I = 3 TO 1 STEP  - 1: PRINT D$;"WRITE RA,R";I: PRINT "REC";I: NEXT
290 PRINT D$;"READ RA,R2": INPUT A$: PRINT D$: PRINT A$
300 PRINT D$;"CLOSE": PRINT D$;"CATALOG"
310 REM THE DISK ITSELF IS WRITE PROTECTED; ONLY THE SCRATCH FILES CAN GO
320 ONERR GOTO 400
330 PRINT D$;"DELETE FIXTURE"
340 PRINT "NOT REACHED"
400 PRINT "DELETE REFUSED"
410 ONERR GOTO 500
420 PRINT D$;"DELETE SCORES": PRINT D$;"VERIFY SCORES"
430 PRINT "NOT REACHED"
500 PRINT "SCORES IS GONE"
510 ONERR GOTO 600
520 PRINT D$;"OPEN NEVER": PRINT D$;"READ NEVER": INPUT A$
530 PRINT "NOT REACHED"
600 PRINT "NOTHING IN A FILE THAT WAS NEVER WRITTEN": END
