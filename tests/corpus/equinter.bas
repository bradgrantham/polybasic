REM APPLESOFT BASIC
4 HOME
5 DIM NM$(100),VL(100),EQ$(15)
10 PRINT "EQUATION INTERPRETER"
15 INPUT ">";A$: IF A$ = "" THEN 15
20 IF LEFT$ (A$,1) = "=" THEN GOSUB 1100: GOTO 15
25 IF A$ = "SET" THEN GOSUB 1000: GOTO 15
30 IF A$ = "STOP" THEN PRINT : PRINT "PROGRAM INTERRUPTED -- STOP ": END
35 IF A$ = "CLEAR" THEN VS = 0: PRINT : PRINT "VAR TABLE RESET.": PRINT : GOTO 15
100 PRINT CHR$ (7)"UNDEFINED": PRINT : GOTO 15
1000 IF VS = 0 THEN PRINT : PRINT CHR$ (7)"NO VARIABLES DEFINED.": PRINT : RETURN
1025 PRINT : PRINT "VARIABLE SET:"
1050 FOR A = 1 TO VS: PRINT TAB( 5);NM$(A)"="VL(A): NEXT : PRINT
1055 RETURN
1100 IF VS = 100 THEN PRINT CHR$ (7)"OUT OF VAR SPACE.": PRINT : RETURN
1103 A$ = RIGHT$ (A$, LEN (A$) - 1): FOR B = 1 TO LEN (A$): IF MID$ (A$,B,1) = ">" THEN S = B
1105 NEXT :NM$ = LEFT$ (A$,S - 1):VL = VAL ( RIGHT$ (A$, LEN (A$) - S))
1107 FOR A = 1 TO VS: IF NM$ = NM$(A) THEN VL(A) = VL:A = VS: NEXT : RETURN
1108 NEXT
1110 VS = VS + 1:NM$(VS) = NM$:VL(VS) = VL: RETURN
