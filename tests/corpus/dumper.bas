REM APPLESOFT BASIC
10 PRINT "DUMPER": INPUT "FILENAME>";FL$
11 IF FL$ = "Q" THEN END
12 INPUT "SL>";SL
15 ONERR GOTO 24
19 IF SL < > 0 THEN PRINT CHR$ (4)"PR#"SL
20 PRINT CHR$ (4)"OPEN"FL$: PRINT CHR$ (4)"READ"FL$
21 GET A$: IF A$ = "<CTRL-E>" THEN END
22 PRINT A$;: GOTO 21
24 IF SL < > 0 THEN PRINT CHR$ (4)"PR#3"
25 PRINT CHR$ (4)"CLOSE": GOTO 10
