REM APPLESOFT BASIC
5 DIM TX$(999)
10 PRINT "DUMPER": INPUT "FILENAME>";FL$
11 IF FL$ = "Q" THEN END
20 PRINT LN;
21 INPUT ">";A$
22 IF LEFT$ (A$,1) < > "." THEN TX$(LN) = A$:LN = LN + 1: GOTO 20
23 A$ = RIGHT$ (A$, LEN (A$) - 1)
24 IF LEFT$ (A$,1) = "C" THEN LN = VAL (A$): GOTO 21
25 IF LEFT$ (A$,1) = "Q" THEN END
26 IF LEFT$ (A$,1) = "W" THEN GOSUB 1000
99 GOTO 20
100 PRINT CHR$ (4)"CLOSE": GOTO 10
1000 PRINT CHR$ (4)"OPEN"FL$: PRINT CHR$ (4)"WRITE"FL$: FOR A = 0 TO LN: PRINT TX$(A): NEXT : PRINT CHR$ (4)"FLUSH": PRINT CHR$ (4)"CLOSE": RETURN
