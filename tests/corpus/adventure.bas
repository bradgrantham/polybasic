REM APPLESOFT BASIC
5 DIM NM$(100),DT(100,6):A = 1
10 HOME : PRINT "WAIT, READING ROOM DATA."
15 READ NM$(A): IF NM$(A) < > "END" THEN READ DT(A,1),DT(A,2),DT(A,3),DT(A,4),DT(A,5),DT(A,6):A = A + 1: GOTO 15
20 A = A - 1: PRINT A" ROOMS COUNTED."
25 PRINT : PRINT : PRINT : PRINT : PRINT :RM = A
27 A = 1
100 HOME : PRINT "YOU ARE NOW IN "NM$(A);"."
105 PRINT "OBVIOUS EXITS ARE:": PRINT "     ";: GOSUB 900
110 PRINT : INPUT "MOVE>";KY$
115 IF KY$ < > "W" AND KY$ < > "E" AND KY$ < > "S" AND KY$ < > "N" AND KY$ < > "S" THEN PRINT CHR$ (7) CHR$ (13)"I DON'T UNDERSTAND.": PRINT : PRINT : GOTO 100
120 IF KY$ = "U" AND DT(A,1) THEN A = DT(A,1): PRINT : PRINT : GOTO 100
125 IF KY$ = "D" AND DT(A,2) THEN A = DT(A,2): PRINT : PRINT : GOTO 100
130 IF KY$ = "E" AND DT(A,3) THEN A = DT(A,3): PRINT : PRINT : GOTO 100
135 IF KY$ = "W" AND DT(A,4) THEN A = DT(A,4): PRINT : PRINT : GOTO 100
140 IF KY$ = "N" AND DT(A,5) THEN A = DT(A,5): PRINT : PRINT : GOTO 100
145 IF KY$ = "S" AND DT(A,6) THEN A = DT(A,6): PRINT : PRINT : GOTO 100
150 PRINT : PRINT CHR$ (7)"YOU CAN'T GO THAT DIRECTION.": PRINT : PRINT : GOTO 100
900 RT = 0: IF DT(A,1) THEN PRINT "UP, ";:RT = 1
905 IF DT(A,2) THEN PRINT "DOWN, ";:RT = 1
910 IF DT(A,3) THEN PRINT "EAST, ";:RT = 1
915 IF DT(A,4) THEN PRINT "WEST, ";:RT = 1
920 IF DT(A,5) THEN PRINT "NORTH, ";:RT = 1
925 IF DT(A,6) THEN PRINT "SOUTH.";:RT = 1
930 IF NOT RT THEN PRINT "NO EXITS."
935 RETURN
