REM APPLESOFT BASIC
5 INPUT "DEGREE OF TRIANGLE DIVISION>";D
10 HGR : POKE - 16302,0
15 REM  DIM TR(4^D,3,3)
20 FOR A = 0 TO 30:PZ = A:PX = A / 7:PY = A / 7: GOSUB 1000: NEXT
998 END
999 REM  3-D PLOT; PX,PY,PZ
1000 IF ( ABS (PY) < (PZ + 20) / 4) AND ( ABS (PX) < (PZ + 20) / 4) THEN HPLOT 139 - (20 * PX / (PZ + 20) / 4) * 139,95 - (20 * PY / (PZ + 20) / 4) * 95
1002 RETURN
