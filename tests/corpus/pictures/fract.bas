REM APPLESOFT BASIC
1 VN = 1
2 GOSUB 2000
4 TEXT
5 CN = 3
10 INPUT "WHAT DEGREE:";DG
15 DIM FL(CN ^ DG,2): PRINT "ELEMENTS:"CN ^ DG
20 INPUT "LENGT +  OF ORIGINAL SEGMENT:";LN
25 FL(1,1) = LN:FL(1,2) = 0
27 EL = 1
30 FOR A = 1 TO DG
35 FOR B = EL TO 1 STEP - 1
40 GOSUB 1000
45 NEXT :EL = EL * CN
50 NEXT
55 DX = 1:DY = 0:X = 139:Y = 95
57 HGR2
60 FOR A = 1 TO EL
65 HPLOT X,Y TO X + (DX * FL(A,1)),Y + (DY * FL(A,1)):X = X + (DX * FL(A,1)):Y = Y + (DY * FL(A,1))
70 AN = AN + FL(A,2) * 1.5707975
75 DX = COS (AN):DY = SIN (AN)
80 NEXT
99 END
1000 FL((B - 1) * CN + 3,1) = S1 * FL(B,1):FL((B - 1) * CN + 3,2) = FL(B,2)
1005 FL((B - 1) * CN + 2,1) = S2 * FL(B,1):FL((B - 1) * CN + 2,2) = VN
1010 FL((B - 1) * CN + 1,1) = S3 * FL(B,1):FL((B - 1) * CN + 1,2) = S4 * VN
1015 RETURN
2000 S1 = .25
2005 S2 = .5
2010 S3 = .25
2015 S4 = - 1
2020 RETURN
