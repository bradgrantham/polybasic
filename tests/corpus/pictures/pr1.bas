REM APPLESOFT BASIC
4 SD = 50
5 HGR : DIM D1(279),D2(279): HCOLOR= 3
7 HPLOT 0,0
10 FOR A = 0 TO 279
15 NE = A + RND (1) * SD: IF NE > 279 THEN NE = 279
20 FOR B = A TO NE:D1(B) = FF: NEXT :A = NE + 1
25 IF FF THEN FF = 0: NEXT : GOTO 32
30 FF = 1: NEXT
32 FOR A = 0 TO 279: HPLOT TO A,64 - 64 * D1(A): NEXT : HPLOT 0,0
35 GOSUB 100
45 FOR A = 0 TO 279: HPLOT TO A,128 - D2(A): NEXT
50 END
100 P1 = 0
105 P2 = 0:FL = D1(P1):SN = 1: IF FL THEN SN = - 1
110 P2 = P2 + 1: IF P1 + P2 = 279 THEN 130
112 IF D1(P1 + P2) = FL THEN 110
115 P3 = 0
120 P3 = P3 + 1: IF P1 + P2 + P3 = 279 THEN 125
122 IF D1(P1 + P2 + P3) < > FL THEN 120
125 P2 = P2 + INT (P3 / 2)
130 FOR B = 0 TO P2 - 1:D2(P1 + B) = SN * 32 * COS (B * (3.1415 / P2)): NEXT
135 P1 = P1 + P2: IF P1 = 279 THEN RETURN
140 GOTO 105
