REM APPLESOFT BASIC
5 HGR2
10 DIM LN(50,4):LN = 50
11 DEF FN DIREC(A) = RND (A) * 5 - 2.5
14 AX = FN DIREC(1):AY = FN DIREC(1):BX = FN DIREC(1):BY = FN DIREC(1)
15 FOR A = 1 TO 50
20 HCOLOR= 0: HPLOT LN(A,1),LN(A,2) TO LN(A,3),LN(A,4)
25 B = A - 1: IF A = 1 THEN B = 50
30 IT = LN(B,1) + AX: IF IT > 279 OR IT < 0 THEN AX = - AX
35 LN(A,1) = LN(B,1) + AX
40 IT = LN(B,2) + AY: IF IT > 191 OR IT < 0 THEN AY = - AY
45 LN(A,2) = LN(B,2) + AY
50 IT = LN(B,3) + BX: IF IT > 279 OR IT < 0 THEN BX = - BX
55 LN(A,3) = LN(B,3) + BX
60 IT = LN(B,4) + BY: IF IT > 191 OR IT < 0 THEN BY = - BY
65 LN(A,4) = LN(B,4) + BY
70 C = INT ( RND (1) * 7) + 1: IF C = 4 THEN C = 3
71 HCOLOR= C
75 HPLOT LN(A,1),LN(A,2) TO LN(A,3),LN(A,4)
80 NEXT : GOTO 15
