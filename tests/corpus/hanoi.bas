REM APPLESOFT BASIC
5 HOME :MV = 0
10 DIM RT(100,3)
15 INPUT "HOW MANY DISKS>";DS
20 S = DS:RT(S,1) = 1:RT(S,2) = 3:RT(S,3) = 2
22 GOSUB 25: GOTO 45
25 IF DS > 1 THEN RT(S - 1,1) = RT(S,1):RT(S - 1,2) = RT(S,3):RT(S - 1,3) = RT(S,2):DS = DS - 1:S = S - 1: GOSUB 25
27 MV = MV + 1
30 PRINT "FROM NDL "RT(S,1)" TO NDL "RT(S,3)".(DISK#"DS",MOVE#"MV")"
35 IF DS > 1 THEN RT(S - 1,1) = RT(S,2):RT(S - 1,2) = RT(S,1):RT(S - 1,3) = RT(S,3):DS = DS - 1:S = S - 1: GOSUB 25
40 DS = DS + 1:S = S + 1: RETURN
45 PRINT : PRINT "END OF INSTRUCTIONS.  "MV" MOVES MADE."
