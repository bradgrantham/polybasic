10 REM GRIFFIN'S KEEP: A SMALL ADVENTURE IN SEVEN ROOMS
20 DIM M(7,6),R$(7),O$(4),A$(4),P(4),D$(6)
30 FOR I=1 TO 6:READ D$(I):NEXT I
40 FOR I=1 TO 7:READ R$(I):FOR J=1 TO 6:READ M(I,J):NEXT J:NEXT I
50 FOR I=1 TO 4:READ O$(I),A$(I),P(I):NEXT I
60 R=1:G=0:S=0:T=0
70 PRINT TAB(19);"GRIFFIN'S KEEP"
80 PRINT
90 PRINT "SOMEWHERE IN THE OLD KEEP LIES A GOLDEN EGG."
92 PRINT "BRING IT BACK OUT TO THE CLEARING."
94 PRINT "TYPE HELP IF YOU ARE STUCK."
100 GOSUB 1000
110 PRINT
120 INPUT "WHAT NOW";A$
130 GOSUB 2000
140 IF V$="" THEN 110
150 T=T+1
160 IF V$="GO" OR V$="WALK" THEN V$=N$
170 D=0
180 FOR I=1 TO 6
190 IF V$=D$(I) OR V$=LEFT$(D$(I),1) THEN D=I
200 NEXT I
210 IF D>0 THEN 3000
220 IF V$="L" OR V$="LOOK" THEN 100
230 IF V$="I" OR V$="INV" OR V$="INVENTORY" THEN 3200
240 IF V$="TAKE" OR V$="GET" THEN 3300
250 IF V$="DROP" THEN 3400
260 IF V$="UNLOCK" OR V$="OPEN" THEN 3500
270 IF V$="READ" THEN 3600
280 IF V$="SAY" THEN 3700
290 IF V$="HELP" THEN 3800
300 IF V$="QUIT" THEN 3900
310 PRINT "I DON'T KNOW HOW TO ";V$;"."
320 GOTO 110
900 DATA NORTH,SOUTH,EAST,WEST,UP,DOWN
910 DATA A FOREST CLEARING,2,0,3,0,0,0
920 DATA BEFORE THE KEEP,4,1,0,0,0,0
930 DATA A RIVERBANK,0,0,0,1,0,0
940 DATA THE GREAT HALL,0,2,5,0,0,6
950 DATA THE LIBRARY,0,0,0,4,0,0
960 DATA THE CELLAR,0,0,7,0,4,0
970 DATA THE VAULT,0,0,0,6,0,0
980 DATA KEY,AN IRON KEY,3,LAMP,A LIT LAMP,4
990 DATA SCROLL,A SCROLL,5,EGG,A GOLDEN EGG,7
1000 REM DESCRIBE THE ROOM
1010 PRINT
1020 GOSUB 2900
1030 IF K=1 THEN PRINT "IT IS PITCH DARK. YOU CAN SEE NOTHING.":RETURN
1040 PRINT R$(R)
1050 ON R GOSUB 1200,1220,1240,1260,1280,1300,1340
1060 FOR I=1 TO 4
1070 IF P(I)=R THEN PRINT "THERE IS ";A$(I);" HERE."
1080 NEXT I
1090 PRINT "EXITS:";
1100 FOR J=1 TO 6
1110 IF M(R,J)<>0 THEN PRINT " ";D$(J);
1120 NEXT J
1130 PRINT
1140 RETURN
1200 PRINT "TALL PINES RING A PATCH OF SUNLIT GRASS."
1210 PRINT "A PATH LEADS NORTH; WATER SOUNDS FROM THE EAST.":RETURN
1220 PRINT "GREY WALLS RISE ABOVE YOU. AN IRON GATE STANDS"
1230 PRINT "IN THE NORTH WALL.":RETURN
1240 PRINT "A SLOW BROWN RIVER SLIDES PAST A GRAVEL BANK.":RETURN
1260 PRINT "DUST LIES THICK ON A LONG TABLE. A DOOR LEADS"
1270 PRINT "EAST AND WORN STEPS GO DOWN.":RETURN
1280 PRINT "SHELVES OF ROTTED BOOKS LINE THE WALLS.":RETURN
1300 PRINT "DAMP STONE AND COBWEBS. AN ARCH OPENS EAST."
1310 IF S=0 THEN PRINT "A GRIFFIN CROUCHES IN THE ARCH, WATCHING YOU."
1320 IF S=1 THEN PRINT "A GRIFFIN SLEEPS BESIDE THE ARCH."
1330 RETURN
1340 PRINT "A SMALL ROUND ROOM. THE WALLS GLITTER.":RETURN
2000 REM A$ IN CAPITALS, SPLIT INTO THE WORDS V$ AND N$
2010 U$=""
2020 FOR I=1 TO LEN(A$)
2030 C=ASC(MID$(A$,I,1)):IF C>96 AND C<123 THEN C=C-32
2040 U$=U$+CHR$(C)
2050 NEXT I
2060 IF LEFT$(U$,1)=" " THEN U$=MID$(U$,2):GOTO 2060
2070 K=0
2080 FOR I=1 TO LEN(U$)
2090 IF K=0 AND MID$(U$,I,1)=" " THEN K=I
2100 NEXT I
2110 V$=U$:N$=""
2120 IF K>0 THEN V$=LEFT$(U$,K-1):N$=MID$(U$,K+1)
2130 IF LEFT$(N$,1)=" " THEN N$=MID$(N$,2):GOTO 2130
2140 RETURN
2800 REM X = THE THING NAMED N$, OR 0
2810 X=0
2820 FOR I=1 TO 4
2830 IF N$=O$(I) THEN X=I
2840 NEXT I
2850 IF X=0 THEN PRINT "I SEE NO SUCH THING."
2860 RETURN
2900 REM K = 1 IF IT IS TOO DARK TO SEE
2910 K=0
2920 IF R>=6 AND P(2)<>0 AND P(2)<>R THEN K=1
2930 RETURN
3000 REM MOVE IN DIRECTION D
3010 GOSUB 2900
3020 IF K=1 AND D<>5 AND D<>4 THEN PRINT "YOU STUMBLE ABOUT IN THE DARK.":GOTO 110
3030 IF M(R,D)=0 THEN PRINT "YOU CAN'T GO THAT WAY.":GOTO 110
3040 IF R=2 AND D=1 AND G=0 THEN PRINT "THE IRON GATE IS LOCKED.":GOTO 110
3050 IF R<>6 OR D<>3 OR S=1 THEN 3080
3060 PRINT "THE GRIFFIN SNAPS ITS BEAK. YOU JUMP BACK."
3070 GOTO 110
3080 R=M(R,D)
3090 IF R=1 AND P(4)=0 THEN 3950
3100 GOTO 100
3200 REM INVENTORY
3210 K=0
3220 FOR I=1 TO 4
3230 IF P(I)=0 THEN PRINT "YOU HAVE ";A$(I);".":K=1
3240 NEXT I
3250 IF K=0 THEN PRINT "YOU ARE CARRYING NOTHING."
3260 GOTO 110
3300 REM TAKE
3310 GOSUB 2900:IF K=1 THEN PRINT "IT IS TOO DARK TO FIND ANYTHING.":GOTO 110
3320 GOSUB 2800:IF X=0 THEN 110
3330 IF P(X)=0 THEN PRINT "YOU ALREADY HAVE IT.":GOTO 110
3340 IF P(X)<>R THEN PRINT "IT IS NOT HERE.":GOTO 110
3350 P(X)=0:PRINT "TAKEN."
3360 GOTO 110
3400 REM DROP
3410 GOSUB 2800:IF X=0 THEN 110
3420 IF P(X)<>0 THEN PRINT "YOU DON'T HAVE IT.":GOTO 110
3430 P(X)=R:PRINT "DROPPED."
3440 GOTO 110
3500 REM UNLOCK
3510 IF R<>2 THEN PRINT "THERE IS NOTHING TO UNLOCK HERE.":GOTO 110
3520 IF G=1 THEN PRINT "THE GATE IS ALREADY OPEN.":GOTO 110
3530 IF P(1)<>0 THEN PRINT "YOU HAVE NO KEY.":GOTO 110
3540 G=1:PRINT "THE KEY TURNS. THE GATE SWINGS OPEN."
3550 GOTO 110
3600 REM READ
3610 IF N$<>"SCROLL" THEN PRINT "YOU CAN'T READ THAT.":GOTO 110
3620 IF P(3)<>0 THEN PRINT "YOU DON'T HAVE IT.":GOTO 110
3630 GOSUB 2900:IF K=1 THEN PRINT "IT IS TOO DARK TO READ.":GOTO 110
3640 PRINT "IN FADED INK: 'THE GRIFFIN SLEEPS WHEN IT HEARS"
3650 PRINT "ITS TRUE NAME, AQUILA.'"
3660 GOTO 110
3700 REM SAY
3710 IF N$<>"AQUILA" OR R<>6 OR S=1 THEN 3750
3720 S=1
3730 PRINT "THE GRIFFIN YAWNS, FOLDS ITS WINGS AND SLEEPS."
3740 GOTO 110
3750 PRINT "YOU SAY '";N$;"'. NOTHING HAPPENS."
3760 GOTO 110
3800 REM HELP
3810 PRINT "MOVE WITH N, S, E, W, U AND D. OTHER WORDS:"
3820 PRINT "LOOK, INVENTORY, TAKE, DROP, UNLOCK, READ, SAY,"
3830 PRINT "QUIT. FOR EXAMPLE: TAKE LAMP"
3840 GOTO 110
3900 PRINT "YOU GIVE UP AFTER";T;"TURNS."
3910 END
3950 PRINT
3960 PRINT "YOU STEP INTO THE SUNLIGHT WITH THE GOLDEN EGG."
3970 PRINT "YOU HAVE WON, IN";T;"TURNS."
3980 END
