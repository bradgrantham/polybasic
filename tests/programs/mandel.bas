10 REM THE MANDELBROT SET IN TEXT, 52 COLUMNS BY 21 ROWS
20 PRINT TAB(19);"MANDELBROT SET"
30 PRINT
40 C$=" .:-=+*#%@"
50 FOR R=0 TO 20
60 Y=-1.2+R*.12
70 L$=""
80 FOR Q=0 TO 51
90 X=-2.1+Q*.0577
100 A=0:B=0:K=0
110 T=A*A-B*B+X:B=2*A*B+Y:A=T:K=K+1
120 IF K<18 AND A*A+B*B<4 THEN 110
130 L$=L$+MID$(C$,INT(K/2)+1,1)
140 NEXT Q
150 PRINT L$
160 NEXT R
170 END
