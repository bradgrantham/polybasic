10 REM BIORHYTHM CHART: THREE SINE WAVES COUNTED FROM A BIRTH DATE
20 PRINT TAB(21);"BIORHYTHM"
30 PRINT
40 DIM L(12)
50 FOR I=1 TO 12:READ L(I):NEXT I
60 DATA 31,28,31,30,31,30,31,31,30,31,30,31
70 PRINT "BIRTH DATE"
80 INPUT "  YEAR, MONTH, DAY";Y,M,D
90 GOSUB 600:IF V=0 THEN 70
100 GOSUB 500:B=J
110 PRINT "FIRST DAY OF THE CHART"
120 INPUT "  YEAR, MONTH, DAY";Y,M,D
130 GOSUB 600:IF V=0 THEN 110
140 GOSUB 500
150 IF J<B THEN PRINT "THAT IS BEFORE THE BIRTH DATE.":GOTO 110
160 INPUT "HOW MANY DAYS (1 TO 60)";N
170 N=INT(N):IF N<1 OR N>60 THEN 160
180 PRINT
190 PRINT "DAYS LIVED BY THE FIRST DAY:";J-B
200 PRINT
210 PRINT "P = PHYSICAL, 23 DAYS   E = EMOTIONAL, 28 DAYS"
220 PRINT "I = INTELLECTUAL, 33 DAYS   * = MORE THAN ONE"
230 PRINT
240 PRINT "DATE   LOW";TAB(27);"0";TAB(44);"HIGH"
250 S$="                    "
260 FOR K=1 TO N
270 A=J-B
280 L$=S$+"!"+S$
290 W=23:C$="P":GOSUB 400
300 W=28:C$="E":GOSUB 400
310 W=33:C$="I":GOSUB 400
320 PRINT RIGHT$(" "+MID$(STR$(M),2),2);"/";RIGHT$("0"+MID$(STR$(D),2),2);"  ";L$
330 GOSUB 700
340 J=J+1
350 NEXT K
360 END
400 REM PUT C$ ON THE LINE WHERE THE CYCLE OF W DAYS STANDS ON DAY A
410 P=INT(21.5+20*SIN(6.283185*A/W))
420 X$=MID$(L$,P,1)
430 IF X$<>" " AND X$<>"!" THEN C$="*"
440 L$=LEFT$(L$,P-1)+C$+MID$(L$,P+1)
450 RETURN
500 REM J = DAY NUMBER OF Y, M, D (THE JULIAN DAY NUMBER)
510 A1=INT((14-M)/12):Y1=Y+4800-A1:M1=M+12*A1-3
520 J=D+INT((153*M1+2)/5)+365*Y1+INT(Y1/4)-INT(Y1/100)+INT(Y1/400)-32045
530 RETURN
600 REM V = 1 IF Y, M, D IS A REAL DATE
610 V=0
620 IF M<1 OR M>12 OR M<>INT(M) OR Y<>INT(Y) OR D<>INT(D) THEN 660
630 GOSUB 800
640 IF D<1 OR D>Z OR Y<1 THEN 660
650 V=1:RETURN
660 PRINT "THAT IS NOT A DATE.":RETURN
700 REM MOVE Y, M, D ON BY ONE DAY
710 GOSUB 800
720 D=D+1:IF D<=Z THEN RETURN
730 D=1:M=M+1:IF M<=12 THEN RETURN
740 M=1:Y=Y+1:RETURN
800 REM Z = DAYS IN MONTH M OF YEAR Y
810 Z=L(M)
820 IF M<>2 THEN RETURN
830 IF Y/4=INT(Y/4) AND Y/100<>INT(Y/100) THEN Z=29
840 IF Y/400=INT(Y/400) THEN Z=29
850 RETURN
