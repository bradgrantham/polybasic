10 REM THE FIRST NUMBER AFTER SEEDING MUST NOT DEPEND ON THE SEED BEING A GOOD ONE
20 REM RND(-X) FOR X = 1 TO 200: THE FIRST VALUES SHOULD COVER 0 TO 1 EVENLY
30 DIM B(9)
40 FOR X = 1 TO 200
50 R = RND(-X): S = S + R
60 B(INT(R * 10)) = B(INT(R * 10)) + 1
70 NEXT X
80 M = S / 200: PRINT "MEAN NEAR A HALF: "; M > .42 AND M < .58
90 L = 200: H = 0
100 FOR I = 0 TO 9
110 IF B(I) < L THEN L = B(I)
120 IF B(I) > H THEN H = B(I)
130 NEXT I
140 PRINT "EVERY TENTH USED: "; L > 5
150 PRINT "NO TENTH CROWDED: "; H < 40
160 REM THE SAME SEED STILL GIVES THE SAME NUMBERS
170 A = RND(-7): A2 = RND(1): C = RND(-7): C2 = RND(1)
180 PRINT "REPEATABLE: "; A = C AND A2 = C2
190 REM RANDOMIZE: THE FIRST VALUE IS NOT ALWAYS SMALL
200 N = 0
210 FOR I = 1 TO 50: RANDOMIZE: IF RND(1) < .05 THEN N = N + 1
220 NEXT I
230 PRINT "RANDOMIZE NOT STUCK LOW: "; N < 25
