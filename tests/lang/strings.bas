10 REM STRING FUNCTIONS AND THE STRING HEAP
20 A$="HELLO, WORLD"
30 PRINT LEFT$(A$,5);"|";RIGHT$(A$,5);"|";MID$(A$,8);"|";MID$(A$,4,2);"|"
40 PRINT LEN(A$);ASC(A$);CHR$(65);CHR$(66)+CHR$(67)
50 PRINT STR$(12);"|";STR$(-3.5);"|";VAL("12.5")+1;VAL("ABC");VAL(" 7X")
60 PRINT "A"<"B";"B"<"A";"ABC"="ABC";"AB"<"ABC";A$<>A$
70 B$=A$+"!":C$=LEFT$(B$,1)+RIGHT$(B$,1):PRINT B$;" ";C$
80 PRINT LEFT$(A$,0);"|";LEFT$(A$,99);"|";MID$(A$,99);"|"
90 REM CHURN THE HEAP SO THAT IT IS COLLECTED MANY TIMES
100 DIM S$(20)
110 FOR I=0 TO 20:S$(I)="ITEM"+STR$(I):NEXT
120 FOR J=1 TO 3000:T$=T$+"X":IF LEN(T$)>200 THEN T$=""
130 NEXT J
140 FOR I=0 TO 20 STEP 5:PRINT S$(I);"/";:NEXT:PRINT
150 PRINT LEN(T$);B$
