REM INTEGER BASIC
10 REM NUMBERS, STRINGS AND JUMPS THE INTEGER BASIC WAY
20 DIM A$(20),N(5),B$(10)
30 A$="HELLO, WORLD":B$="XY"
40 PRINT A$;" ";LEN(A$);" ";A$(8);" ";A$(1,5);" ";ASC(A$);" ";ASC(A$(2))
50 A$(6)="!": PRINT A$:A$(LEN(A$)+1)=B$: PRINT A$
60 I=3: PRINT A$(I,I+1);A$(LEN(A$));LEN(A$(2,4))
70 FOR I=1 TO 5:N(I)=I*I: NEXT I
80 PRINT N(3),N(5),7/2,-7/2
90 PRINT 7 MOD 3;" ";-7 MOD 3;" ";2^10;" ";-3^2;" ";2+3*4;" ";(2+3)*4
100 PRINT 1=1;1#1;3<>4; NOT 0;5>3 AND 2>1;0 OR 0;2<=2;3>=4
110 PRINT A$="HELLO!XY";A$#"HELLO!XY";A$(1,1)="H"
120 IF A$#"X" THEN PRINT "DIFFERENT": PRINT "ALWAYS"
130 IF 0 THEN PRINT "NEVER": PRINT "THE REST OF THE LINE RUNS"
140 IF 2 THEN 160
150 PRINT "NOT REACHED"
160 X=30: GOSUB X*10+200: GOTO 150+X
180 FOR I=3 TO 1 STEP -1: FOR J=1 TO 2: PRINT I*J;" ";: NEXT J,I: PRINT
190 FOR I=5 TO 1: PRINT "ONCE";I: NEXT I
200 R=RND (6): PRINT R>=0 AND R<6; RND (1); SGN (-9); ABS (-9)
210 GOSUB 600: PRINT "POPPED"
220 CALL=936: REM A WORD WITH = AFTER IT IS A VARIABLE
230 LONGNAME=7:LONGNAMETOO=8: PRINT LONGNAME*LONGNAMETOO
240 TAB 10: PRINT "TEN": PRINT "A","B",1,22
250 INPUT "NUMBER",Q: PRINT Q*2
260 INPUT "TWO",Q,R: PRINT Q+R
270 INPUT "NAME ",A$: PRINT "[";A$;"]"
280 INPUT B$: PRINT B$
290 LIST 280,290
300 CLR : PRINT Q;N(3)
310 PRINT 32767+1
320 PRINT "NOT REACHED"
500 PRINT "SUB 500": RETURN
600 GOSUB 610: PRINT "NOT REACHED": RETURN
610 POP : RETURN
