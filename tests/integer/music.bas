REM INTEGER BASIC
10 REM NOTE ROUTINES ARE KNOWN BY THEIR FIRST BYTES AND PLAYED WITHOUT A 6502.
20 REM THE FILE HERE HAS ONLY THOSE BYTES, AT TWO OF THE 42 ADDRESSES.
30 PRINT "<CTRL-D>BLOAD NOTES"
40 G=3373:A=4310
50 POKE 2057,5: CALL G: PRINT "ONE": CALL A: PRINT "TWO"
60 POKE 2057,1: CALL G: PRINT "NO LENGTH, NO NOTE"
70 POKE 3373,0: CALL A: PRINT "THREE"
80 CALL G
90 PRINT "NOT REACHED"
