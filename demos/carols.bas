REM GRIFFIN BASIC
10 REM CHRISTMAS CAROLS, AFTER THE APPLE II DISK OF THAT NAME.
20 REM THIS IS THE PLAYER ONLY.  THE CAROLS ARE DATA FROM LINE 9000 ON,
30 REM WHICH tools/carols.py MAKES FROM THE DISK: SEE "make carols".
40 REM KEYS: W AND S (OR UP AND DOWN) MOVE, A AND D (OR LEFT AND RIGHT)
50 REM TURN THE PAGE, SPACE OR RETURN CHOOSES.  THE JOYSTICK DOES THE
60 REM SAME.  ANY KEY STOPS A CAROL.
70 RANDOMIZE
80 RESTORE 9000: READ count
90 DIM title$(count), hz(70), queue(10), item$(24), ix(24), iy(24)
100 FOR i = 1 TO count: READ title$(i): NEXT i
110 REM A NOTE IS A MIDI NUMBER: 69 IS THE A OF 440 HERTZ
120 FOR p = 40 TO 70: hz(p) = 440 * 2 ^ ((p - 69) / 12): NEXT p
130 back = RGB(0, 0, 80): ink = RGB(255, 255, 255): bar = RGB(200, 0, 0)
140 gold = RGB(255, 220, 0): faint = RGB(110, 110, 190)
150 REM unit: MILLISECONDS IN ONE UNIT OF NOTE LENGTH.  gap: SILENCE TAKEN
160 REM FROM THE END OF EACH NOTE SO THAT REPEATED NOTES ARE HEARD APART.
170 unit = 88: gap = 10: perpage = 19
180 REM WORDS ARE PLACED AS ON THE APPLE'S 40 BY 24 SCREEN, WHICH SITS IN
190 REM THE MIDDLE OF THIS ONE: COLUMN c IS AT 13 + c * 7, ROW r AT 16 + r * 8.
200 REM
210 REM ---- THE FIRST MENU
220 CLS back: GOSUB 1950: GOSUB 1900
230 GPRINT 62, 52, "WOULD YOU LIKE TO:", ink
240 item$(1) = "PLAY ONE SONG AT A TIME"
250 item$(2) = "PLAY A SELECTION OF 1 TO 10 SONGS"
260 item$(3) = "PLAY ALL SONGS ONE TIME THROUGH"
270 item$(4) = "END THE SESSION"
280 FOR i = 1 TO 4: ix(i) = 41: iy(i) = 60 + i * 16: NEXT i
290 GPRINT 41, 220, "W S MOVE   SPACE CHOOSES", faint
300 items = 4: cur = 1: turn = 0: GOSUB 2000
310 mode = pick: cur = 1: pagenum = 1: chosen = 0
320 ON mode GOTO 500, 600, 400, 800
330 REM
400 REM ---- ALL THE SONGS
410 CLS back: FRECT 132, 39, 55, 10, bar: GPRINT 135, 40, "WARNING", ink
420 GPRINT 41, 64, "IT TAKES ABOUT AN HOUR TO PLAY", ink
430 GPRINT 41, 76, "ALL SONGS ONE TIME THROUGH.", ink
440 item$(1) = "OK, PLAY THEM ALL": item$(2) = "RETURN TO THE FIRST MENU"
450 item$(3) = "END THE SESSION"
460 FOR i = 1 TO 3: ix(i) = 41: iy(i) = 96 + i * 16: NEXT i
470 items = 3: cur = 1: turn = 0: GOSUB 2000
480 ON pick GOTO 485, 220, 800
485 VSYNC 30: n = 1
490 carol = n: GOSUB 3000: IF stopped THEN 220
495 n = n + 1: IF n <= count THEN 490 ELSE 220
500 REM ---- ONE SONG AT A TIME
510 GOSUB 1000
520 IF pick = -1 THEN 220
530 IF pick = -2 THEN 800
540 carol = pick: GOSUB 1800: GOSUB 3000: GOTO 510
600 REM ---- A SELECTION OF UP TO TEN
610 GOSUB 1000
620 IF pick = -1 THEN 220
630 IF pick = -2 THEN 800
640 IF pick = -3 THEN 660
650 chosen = chosen + 1: queue(chosen) = pick: IF chosen < 10 THEN 610
660 CLS back: GPRINT 118, 88, "THANK YOU", ink: VSYNC 60
670 n = 1
680 carol = queue(n): GOSUB 3000: IF stopped THEN 220
690 n = n + 1: IF n <= chosen THEN 680 ELSE 220
700 REM
800 REM ---- THE END
810 CLS back: GOSUB 1950
820 GPRINT 132, 64, "HAVE A", ink
830 GPRINT 139, 80, "VERY", ink
840 GPRINT 104, 96, "MERRY CHRISTMAS", gold
850 GPRINT 132, 112, "AND A", ink
860 GPRINT 104, 128, "HAPPY NEW YEAR", gold
870 END
880 REM
1000 REM ---- THE CAROL MENU, A PAGE AT A TIME.  IT GIVES pick: A CAROL'S
1010 REM NUMBER, OR -1 FOR THE FIRST MENU, -2 TO STOP, -3 TO BEGIN PLAYING
1020 CLS back: GPRINT 69, 4, "CHRISTMAS CAROL MENU", gold
1030 GPRINT 216, 4, "PAGE" + STR$(pagenum) + " OF 2", faint
1040 first = (pagenum - 1) * perpage: items = 0
1050 FOR i = 1 TO perpage
1060 n = first + i: IF n > count THEN 1100
1070 n$ = MID$(STR$(n), 2): IF n < 10 THEN n$ = " " + n$
1080 items = items + 1: item$(items) = n$ + ") " + title$(n)
1090 ix(items) = 20: iy(items) = 8 + i * 10
1100 NEXT i
1110 titles = items: y = 212
1120 items = items + 1: item$(items) = "OTHER PAGE": ix(items) = 20: iy(items) = y
1130 IF mode = 2 THEN items = items + 1: item$(items) = "BEGIN": ix(items) = 111: iy(items) = y
1140 items = items + 1: item$(items) = "FIRST MENU": ix(items) = 167: iy(items) = y
1150 items = items + 1: item$(items) = "STOP": ix(items) = 258: iy(items) = y
1160 IF msg$ = "" AND mode = 2 THEN msg$ = "CHOOSE SONG" + STR$(chosen + 1) + " OF UP TO 10, OR BEGIN"
1170 GPRINT 20, 228, msg$, gold: msg$ = ""
1180 turn = 1: GOSUB 2000
1190 IF pick = 0 THEN pagenum = 3 - pagenum: GOTO 1020
1200 IF pick <= titles THEN pick = first + pick: RETURN
1210 IF item$(pick) = "OTHER PAGE" THEN pagenum = 3 - pagenum: GOTO 1020
1220 IF item$(pick) = "FIRST MENU" THEN pick = -1: RETURN
1230 IF item$(pick) = "STOP" THEN pick = -2: RETURN
1240 IF chosen > 0 THEN pick = -3: RETURN
1250 msg$ = "YOU MUST ENTER AT LEAST ONE SONG.": GOTO 1020
1260 REM
1800 REM ---- A KIND WORD ABOUT THE CHOICE
1810 CLS back: r = INT(4 * RND(1)) + 1
1820 ON r GOTO 1830, 1840, 1850, 1860
1830 GPRINT 83, 104, "AN EXCELLENT CHOICE!", ink: GOTO 1870
1840 GPRINT 118, 104, "THANK YOU", ink: GOTO 1870
1850 GPRINT 125, 96, "OH BOY!", ink: GPRINT 83, 112, "ONE OF MY FAVORITES", ink: GOTO 1870
1860 GPRINT 97, 104, "A FINE SELECTION", ink
1870 VSYNC 90: RETURN
1880 REM
1900 REM ---- THE NAME, WHITE ON BLACK TURNED ROUND AS THE APPLE HAD IT
1910 FRECT 102, 23, 116, 10, ink: GPRINT 104, 24, "CHRISTMAS CAROLS", back: RETURN
1920 REM
1950 REM ---- SNOW
1960 FOR i = 1 TO 70: PSET INT(RND(1) * 320), INT(RND(1) * 240), faint: NEXT i: RETURN
1970 REM
2000 REM ---- CHOOSE ONE OF item$(1) TO item$(items), DRAWN AT ix(), iy(),
2010 REM STARTING ON cur.  IT GIVES pick: THE ITEM'S NUMBER, OR 0 IF THE
2020 REM PAGE WAS TURNED (WHICH ONLY HAPPENS IF turn IS SET)
2030 IF cur < 1 OR cur > items THEN cur = 1
2040 FOR i = 1 TO items: GPRINT ix(i), iy(i), item$(i), ink: NEXT i
2050 old = 0
2060 IF cur = old THEN 2100
2070 IF old > 0 THEN FRECT ix(old) - 2, iy(old) - 1, LEN(item$(old)) * 7 + 4, 10, back: GPRINT ix(old), iy(old), item$(old), ink
2080 FRECT ix(cur) - 2, iy(cur) - 1, LEN(item$(cur)) * 7 + 4, 10, bar: GPRINT ix(cur), iy(cur), item$(cur), ink
2090 old = cur
2100 VSYNC: GOSUB 2500
2110 IF move = 1 THEN cur = cur - 1: IF cur < 1 THEN cur = items
2120 IF move = 2 THEN cur = cur + 1: IF cur > items THEN cur = 1
2130 IF (move = 3 OR move = 4) AND turn THEN pick = 0: RETURN
2140 IF move = 5 THEN pick = cur: RETURN
2150 GOTO 2060
2160 REM
2500 REM ---- LOOK AT THE KEYBOARD AND JOYSTICK ONCE.  IT GIVES move:
2510 REM 0 NOTHING, 1 UP, 2 DOWN, 3 LEFT, 4 RIGHT, 5 CHOOSE
2520 move = 0: k = 0: k$ = INKEY$: IF k$ <> "" THEN k = ASC(k$)
2530 IF k = 11 OR k = 87 OR k = 119 THEN move = 1
2540 IF k = 10 OR k = 83 OR k = 115 THEN move = 2
2550 IF k = 8 OR k = 65 OR k = 97 THEN move = 3
2560 IF k = 21 OR k = 68 OR k = 100 THEN move = 4
2570 IF k = 13 OR k = 32 THEN move = 5
2580 REM THE JOYSTICK COUNTS WHEN IT CHANGES; HELD A THIRD OF A SECOND, A
2590 REM DIRECTION THEN REPEATS TEN TIMES A SECOND
2600 j = JOY(3): IF j <> lastjoy THEN held = 0: lastjoy = j: GOTO 2630
2610 held = held + 1: IF held < 20 OR j = 0 THEN RETURN
2620 held = 14: IF j AND 16 THEN RETURN
2630 IF move THEN RETURN
2640 IF j AND 1 THEN move = 1
2650 IF j AND 2 THEN move = 2
2660 IF j AND 4 THEN move = 3
2670 IF j AND 8 THEN move = 4
2680 IF j AND 16 THEN move = 5
2690 RETURN
2700 REM
3000 REM ---- PLAY THE CAROL NUMBERED carol.  stopped IS SET IF A KEY OR
3010 REM THE FIRE BUTTON ENDED IT.  THE DATA: 100 OR MORE IS A NOTE (PITCH
3020 REM TIMES 100, PLUS LENGTH); LESS THAN 0 A REST OF THAT MANY
3030 REM MILLISECONDS; 0 WORDS (ROW, COLUMN, TEXT); 1 CLEAR THE SCREEN;
3040 REM 2 THE END; 3 A CAROL THAT IS NOT ON THE DISK.
3050 REM NOTES ARE ONLY QUEUED HERE.  THE WORDS OF A LINE COME BEFORE ITS
3060 REM NOTES, SO BEFORE WORDS ARE DRAWN THE QUEUE IS LEFT TO RUN OUT.
3070 stopped = 0: dirty = 1: GOSUB 9500
3080 READ v
3090 IF v >= 100 THEN p = INT(v / 100): SOUND hz(p), (v - p * 100) * unit - gap: SOUND 0, gap: GOTO 3080
3100 IF v < 0 THEN SOUND 0, -v: GOTO 3080
3110 IF v = 3 THEN 3200
3120 GOSUB 3300: IF stopped THEN RETURN
3130 IF v = 2 THEN RETURN
3140 IF v = 1 AND dirty THEN GOSUB 3400
3150 IF v = 1 THEN 3080
3160 READ r, c, w$: GPRINT 13 + c * 7, 16 + r * 8, w$, ink: dirty = 1: GOTO 3080
3170 REM
3200 REM NOT ON THE DISK: SAY SO, UNLESS PLAYING THEM ALL
3210 IF mode = 3 THEN RETURN
3220 GOSUB 3400: GPRINT 41, 96, "THIS CAROL WAS LOST FROM THE DISK.", ink
3230 VSYNC 150: RETURN
3240 REM
3300 REM WAIT FOR THE NOTES QUEUED TO FINISH, OR TO BE STOPPED
3310 IF INKEY$ <> "" OR JOY(2) THEN stopped = 1: SOUND OFF: RETURN
3320 IF PLAYING(0) THEN 3310
3330 RETURN
3340 REM
3400 REM A CLEAN SCREEN WITH THE CAROL'S NAME ABOVE WHERE THE WORDS GO
3410 CLS back: GPRINT INT(160 - LEN(title$(carol)) * 3.5), 6, title$(carol), gold
3420 GPRINT 114, 226, "ANY KEY STOPS", faint: dirty = 0: RETURN
