REM GRIFFIN BASIC
10 REM ODE TO JOY (BEETHOVEN) ON THREE VOICES, WITH LIGHTS
20 CLS 0
30 GPRINT 104, 20, "ODE TO JOY", RGB(255, 255, 0)
40 GPRINT 48, 220, "THREE SQUARE WAVES - ANY KEY STOPS", RGB(128, 128, 128)
50 melody$ = "T120 O4 L4 V10 EEFG GFED CCDE E.D8D2 EEFG GFED CCDE D.C8C2"
60 harmony$ = "T120 O3 L2 V6 CG CG EG CG CG CG EG G4<B4>C"
70 bass$ = "T120 O2 L1 V8 C C C G C C C G2C2"
80 PLAY melody$, harmony$, bass$
90 melody$ = "T120 O4 L4 V10 DDEC DE8F8EC DE8F8ED CD<G2> >EEFG GFED CCDE D.C8C2"
100 harmony$ = "T120 O3 L2 V6 GG GE GE DG CG CG EG G4<B4>C"
110 bass$ = "T120 O2 L1 V8 G G G G C C C G2C2"
120 PLAY melody$, harmony$, bass$
130 lit = 0
200 REM LIGHTS WHILE IT PLAYS
210 IF NOT PLAYING(0) THEN 300
220 lit = lit + 1: IF lit > 12 THEN lit = 1
230 FOR i = 1 TO 12
240 shade = 255 - (ABS(i - lit) * 60): IF shade < 40 THEN shade = 40
250 FCIRCLE 14 + i * 22, 120, 8, RGB(shade, shade / 2, 0)
260 NEXT i
270 IF INKEY$ <> "" THEN SOUND OFF: GOTO 300
280 VSYNC 6
290 GOTO 210
300 TEXT
